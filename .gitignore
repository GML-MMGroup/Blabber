# Local workspaces and generated patent material
/open-notebook/
/patent_output/
/patent_ppt_build/
/patent_ppt_figure3/
/patent_ppt_figure4/
/patent_ppt_figure5/
/patent_ppt_slide2/
/.git-backups/

# macOS metadata
.DS_Store
**/.DS_Store

# Python caches and local environments
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
**/.venv/

# Local runtime state and credentials
/mvp/output/
/mvp/.env
/mvp/.env.*
!/mvp/.env.example

# Logs and temporary files
*.log
*.tmp
*.temp

# Release only the four characters that currently support video generation.
# Other character assets remain in place locally, but Git does not track them.
/assets/action/*
!/assets/action/male/
!/assets/action/male/**
!/assets/action/female/
!/assets/action/female/**
!/assets/action/dog/
!/assets/action/dog/**
!/assets/action/duck/
!/assets/action/duck/**

# Inside the four supported roles, publish only the transparent runtime MOVs.
# Raw non-alpha clips and frame-generation workdirs stay local.
/assets/action/male/*.mov
!/assets/action/male/*-alpha-prores4444.mov
/assets/action/female/*.mov
!/assets/action/female/*-alpha-prores4444.mov
/assets/action/dog/*.mov
!/assets/action/dog/*-alpha-prores4444.mov
/assets/action/duck/*.mov
!/assets/action/duck/*-alpha-prores4444.mov
/assets/action/male/*/
/assets/action/female/*/
/assets/action/dog/*/
/assets/action/duck/*/

/assets/character/*
!/assets/character/cartoon-male.png
!/assets/character/cartoon-female.png
!/assets/character/funny-podcast-dog.png
!/assets/character/funny-podcast-duck.png

# Frontend copies for characters outside the current four-role release.
/site/public/anime-host-*.png
/site/public/clay-*.png
/site/public/flat-tech-host-*.png
/site/public/lowpoly-host-*.png
/site/public/profes-*.png
/site/public/retro-*.png
/site/public/toon3d-*.png

# Keep macOS metadata ignored even inside explicitly included asset folders.
**/.DS_Store
