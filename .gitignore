# Local workspaces and generated patent material
/open-notebook/
/patent_output/
/patent_ppt_build/
/patent_ppt_figure3/
/patent_ppt_figure4/
/patent_ppt_figure5/
/patent_ppt_slide2/
/.git-backups/

# macOS metadata
.DS_Store
**/.DS_Store

# Python caches and local environments
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
**/.venv/

# Local runtime state and credentials
/mvp/output/
/mvp/.env
/mvp/.env.*
!/mvp/.env.example

# Logs and temporary files
*.log
*.tmp
*.temp

# Release only the two characters that currently support video generation.
# Other character assets remain in place locally, but Git does not track them.
/assets/action/*
!/assets/action/dog/
!/assets/action/dog/**
!/assets/action/duck/
!/assets/action/duck/**

# Keep the ProRes masters local and publish only lightweight VP9 Alpha files.
# The compositor prefers MOV locally and falls back to WebM in GitHub clones.
/assets/action/dog/*.mov
/assets/action/duck/*.mov
/assets/action/dog/*.webm
!/assets/action/dog/*-alpha-vp9.webm
/assets/action/duck/*.webm
!/assets/action/duck/*-alpha-vp9.webm
/assets/action/dog/*/
/assets/action/duck/*/

# Demo source videos stay local; the published runtime does not require them.
/assets/demo/*.mp4

/assets/character/*
!/assets/character/funny-podcast-dog.png
!/assets/character/funny-podcast-duck.png

# Publish only the Zoo background and foreground; keep other scene sources local.
/assets/background/*
!/assets/background/zoo_background.png
!/assets/background/zoo_foreground.png

# Frontend copies for characters outside the current two-role release.
/site/public/anime-host-*.png
/site/public/clay-*.png
/site/public/flat-tech-host-*.png
/site/public/lowpoly-host-*.png
/site/public/profes-*.png
/site/public/retro-*.png
/site/public/toon3d-*.png

# Keep the frontend release aligned with Duck + Dog in the Zoo scene.
/site/public/cartoon-male.png
/site/public/cartoon-female.png
/site/public/action-preview-male.png
/site/public/action-preview-female.png
/site/public/funny-podcast-dog-alpha-v2.png
/site/public/funny-podcast-duck-alpha-v2.png
/site/public/scene-*.png
/site/public/scene-*-composite.jpg
!/site/public/scene-zoo.png
!/site/public/scene-zoo-foreground.png

# Keep macOS metadata ignored even inside explicitly included asset folders.
**/.DS_Store
