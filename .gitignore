# Local workspaces and generated patent material
/open-notebook/
/patent_output/
/patent_ppt_build/
/patent_ppt_figure3/
/patent_ppt_figure4/
/patent_ppt_figure5/
/patent_ppt_slide2/
/.git-backups/

# macOS metadata
.DS_Store
**/.DS_Store

# Python caches and local environments
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
**/.venv/

# Local runtime state and credentials
/mvp/output/
/mvp/.env
/mvp/.env.*
!/mvp/.env.example

# Logs and temporary files
*.log
*.tmp
*.temp

# Downloaded subtitle fonts are runtime cache, not repository assets.
/mvp/fonts/

# Release only characters that have a usable video action asset.
/assets/action/*
!/assets/action/dog/
!/assets/action/duck/
!/assets/action/female/
!/assets/action/male/
!/assets/action/anime-reference-host-female/
!/assets/action/anime-reference-host-male/
!/assets/action/flat-tech-host-female/
!/assets/action/flat-tech-host-male/
!/assets/action/lowpoly-host-female/
!/assets/action/lowpoly-host-male/

# Keep ProRes masters and work files local; publish lightweight VP9 Alpha.
/assets/action/dog/*
!/assets/action/dog/*-alpha-vp9.webm
!/assets/action/dog/frame-000001.png
/assets/action/duck/*
!/assets/action/duck/*-alpha-vp9.webm
!/assets/action/duck/frame-000001.png
/assets/action/female/*
!/assets/action/female/*-alpha-vp9.webm
/assets/action/male/*
!/assets/action/male/*-alpha-vp9.webm
/assets/action/anime-reference-host-female/*
!/assets/action/anime-reference-host-female/*-alpha-vp9.webm
/assets/action/anime-reference-host-male/*
!/assets/action/anime-reference-host-male/*-alpha-vp9.webm
/assets/action/flat-tech-host-female/*
!/assets/action/flat-tech-host-female/*-alpha-vp9.webm
/assets/action/flat-tech-host-male/*
!/assets/action/flat-tech-host-male/*-alpha-vp9.webm
/assets/action/lowpoly-host-female/*
!/assets/action/lowpoly-host-female/*-alpha-vp9.webm
/assets/action/lowpoly-host-male/*
!/assets/action/lowpoly-host-male/*-alpha-vp9.webm

# Demo source videos stay local; the published runtime does not require them.
/assets/demo/*.mp4

/assets/character/*
!/assets/character/funny-podcast-dog.png
!/assets/character/funny-podcast-duck.png
!/assets/character/cartoon-female.png
!/assets/character/cartoon-male.png
!/assets/character/anime-reference-host-female.png
!/assets/character/anime-reference-host-male.png
!/assets/character/flat-tech-host-female.png
!/assets/character/flat-tech-host-male.png
!/assets/character/lowpoly-host-female.png
!/assets/character/lowpoly-host-male.png

# All background/foreground pairs are published for runtime composition.

# Frontend-only characters without video action assets remain local.
/site/public/clay-*.png
/site/public/profes-*.png
/site/public/retro-*.png
/site/public/toon3d-*.png

# Unused alternate cutouts stay local; action previews are generated from video.
/site/public/funny-podcast-dog-alpha-v2.png
/site/public/funny-podcast-duck-alpha-v2.png

# Keep macOS metadata ignored even inside explicitly included asset folders.
**/.DS_Store
